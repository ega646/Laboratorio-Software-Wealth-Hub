# Copiar este archivo como .env.local y rellenar los valores
# Los valores de Supabase se obtienen en: Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (solo server-side, nunca al cliente)
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# APIs externas de precios (UC05)
COINGECKO_API_KEY=          # Opcional — el tier gratuito funciona sin clave
ALPHAVANTAGE_API_KEY=       # Necesario para activos tipo INVERSION

# Cron secret: string aleatorio para proteger GET /api/precios/cron
# Ejemplo: openssl rand -hex 32
CRON_SECRET=
